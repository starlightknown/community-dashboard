# Discord Integration Configuration
# Obtain these from the Discord Developer Portal (https://discord.com/developers/applications)

# The ID of your Discord Application
DISCORD_CLIENT_ID=your_client_id_here

# The Secret of your Discord Application
DISCORD_CLIENT_SECRET=your_client_secret_here

# The ID of the Discord Guild (Server) you want to track
DISCORD_GUILD_ID=your_guild_id_here

# Optional: Discord Bot Token for server-side fetching
DISCORD_BOT_TOKEN=your_bot_token_here

# Database Configuration (Vercel Postgres)
# These will be automatically populated when you connect Vercel Postgres in the Vercel Dashboard
POSTGRES_URL=postgresql://...

# NextAuth Configuration
# Set this to your production URL (e.g., https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=a_random_secret_string
